{
  "name": "openclaw-mouse",
  "displayName": "OpenClaw Mouse Control",
  "version": "1.0.0",
  "description": "OpenClaw 智能鼠标控制技能 - 赋予 AI Agent 完全控制用户电脑鼠标的能力",
  "author": "OpenClaw",
  "repository": "https://github.com/f15325978807/openclaw-mouse-control",
  "license": "MIT",
  "commands": [
    "mouse",
    "keyboard",
    "screen",
    "message",
    "app"
  ],
  "binaries": {
    "openclaw-mouse": "openclaw_mouse:app_cli"
  },
  "dependencies": {
    "pyautogui": ">=0.9.54",
    "typer": ">=0.9.0",
    "pillow": ">=10.0.0"
  },
  "openclaw": {
    "compatible": true,
    "minVersion": "1.0.0",
    "configPath": "~/.openclaw/openclaw.json"
  },
  "install": "pip install -e .",
  "entry": {
    "cli": "openclaw-mouse",
    "module": "openclaw_mouse"
  }
}
